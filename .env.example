# =============================================================================
# Egreen-Quanta Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure values before starting the application.

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL 15+)
# -----------------------------------------------------------------------------
# Standard local Docker Compose URL:
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/egreen_quanta

# Database credentials (used by docker-compose for initializing PostgreSQL container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=egreen_quanta
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
# Secret key used for signing JWT access tokens (must be set in production!)
JWT_SECRET_KEY=egreen-quanta-jwt-secret-key-2026-prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------------------------------------------------------------------
# Gemini AI Configuration (AI Tutor & Misconception Diagnostics)
# -----------------------------------------------------------------------------
# Google AI Studio API Key (server-side only, NEVER expose to client)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# -----------------------------------------------------------------------------
# Server & CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Server host and port
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# Frontend Client URL
# -----------------------------------------------------------------------------
# API URL used by frontend Vite client (leave empty or set to / in reverse-proxy mode)
VITE_API_URL=http://localhost:8000
