# =============================================================================
# Egreen-Quanta Frontend Environment Configuration
# =============================================================================
# Set to custom backend URL (e.g., https://api.egreenquanta.com)
# For local development with backend on port 8000:
VITE_API_URL=http://localhost:8000

# When running in reverse-proxy / single-origin mode behind Nginx, leave empty:
# VITE_API_URL=
